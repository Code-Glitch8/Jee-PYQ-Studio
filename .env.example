# Copy to python-importer/.env for LOCAL importer runs only. Never commit the real file.
# In GitHub, these live in Settings > Secrets and variables > Actions.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me-server-side-only
AI_PROVIDER=gemini            # gemini | openrouter | openai_compatible
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
# Optional importer tuning (also settable as workflow inputs)
IMPORT_MODE=full              # full | discover_only | process_only | retry_failed
IMPORT_MAX_DEPTH=3            # link depth followed from each official homepage
IMPORT_MAX_PAGES=60           # pages read per site
IMPORT_MAX_DOWNLOADS=80       # PDFs downloaded per run
IMPORT_DELAY=3                # seconds between requests to one host (never below robots.txt Crawl-delay)
